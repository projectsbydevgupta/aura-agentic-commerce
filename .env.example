# ==============================================================================
# AURA Luxury Fashion Concierge — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your actual credentials and endpoints.
# DO NOT commit .env with real credentials to GitHub.

PROJECT_NAME="AURA Luxury Fashion Concierge"
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# ------------------------------------------------------------------------------
# Groq Cloud LLM API Keys (Multi-Agent Specialization)
# ------------------------------------------------------------------------------
GROQ_API_KEY_QUERY=your_groq_api_key_query
GROQ_API_KEY_CONTEXT=your_groq_api_key_context
GROQ_API_KEY_VALIDATION=your_groq_api_key_validation
GROQ_API_KEY_UPSELL=your_groq_api_key_upsell
GROQ_API_KEY_CAMPAIGN=your_groq_api_key_campaign
GROQ_API_KEY=your_groq_api_key_fallback
LLM_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# Voyage AI Embeddings (512-dim Dense Vectors)
# ------------------------------------------------------------------------------
VOYAGE_API_KEY=your_voyage_api_key
VOYAGE_MODEL=voyage-3-lite
EMBEDDING_DIM=512

# ------------------------------------------------------------------------------
# MongoDB Atlas (Catalog & Vector Search)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_PASSWORD=your_mongodb_password
MONGODB_DB_NAME=ecommerce_catalog
MONGODB_COLLECTION_NAME=products
MONGODB_VECTOR_INDEX_NAME=vector_index

# ------------------------------------------------------------------------------
# Razorpay Test Credentials (Cart Checkout & Agent-to-Agent Payment)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------------------------------------------
# WhatsApp Automation & Baileys Bridge
# ------------------------------------------------------------------------------
WHATSAPP_BAILEYS_URL=http://127.0.0.1:5001
WHATSAPP_BAILEYS_PORT=5001
WHATSAPP_QUEUE_COLLECTION=whatsapp_messages
WHATSAPP_SESSION_COLLECTION=whatsapp_sessions
WHATSAPP_SESSION_ID=default_session
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_POLL_INTERVAL=5.0
WHATSAPP_RATE_LIMIT_DELAY=3.0
WHATSAPP_DRY_RUN=false

# ------------------------------------------------------------------------------
# Security Guardrails & Evaluation Controls
# ------------------------------------------------------------------------------
GUARDRAILS_ENABLED=true
GUARDRAILS_STRICT_BUDGET=true
OBSERVABILITY_TRACING=true
TRACING_SERVICE_NAME=aura-agentic-mas
MCP_SERVER_PORT=8001

# ------------------------------------------------------------------------------
# Arize Phoenix OpenTelemetry Tracing (MAS Telemetry)
# ------------------------------------------------------------------------------
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/aura-commerce/v1/traces
PHOENIX_API_KEY=your_phoenix_api_key
OTEL_EXPORTER_OTLP_HEADERS="api_key=your_phoenix_api_key"
PHOENIX_PROJECT_NAME=aura-commerce
PHOENIX_LOCAL_PORT=6006
